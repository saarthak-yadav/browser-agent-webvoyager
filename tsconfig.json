{
  "compilerOptions": {
    // Environment setup & latest features.
    // DOM is here because `page.evaluate(() => document...)` callbacks are
    // serialised and run inside the browser page, where DOM globals are real.
    // It adds declarations; it relaxes no check. The cost is that `document`
    // also typechecks in Bun-side code, where it would throw at runtime — so
    // browser globals belong inside evaluate callbacks and nowhere else.
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
